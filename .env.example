# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=cafe
POSTGRES_PASSWORD=cafe_pass
POSTGRES_DB=cafe
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# Filled in later phases
GROQ_API_KEY=
NVIDIA_API_KEY=
# Only needed if AGENT_LLM_PROVIDER = "openrouter" in backend/constant.py
OPENROUTER_API_KEY=

# Optional: only for the Phase 1 audio_lab STT/TTS comparison notebook.
# Leave blank to skip that provider - the notebook handles missing keys gracefully.
HUGGINGFACE_API_KEY=
ELEVENLABS_API_KEY=

# Optional: LangSmith tracing for the Phase 3 agent (free account at smith.langchain.com).
# Off by default. Set LANGSMITH_TRACING=true and fill the key to turn it on.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=voice-agent-cafe
